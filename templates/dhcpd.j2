# =====================================================================
#  /etc/dhcp/dhcpd.conf  —  GENERATED by ztp-app v3. Do NOT hand-edit.
#  Vendor-neutral Juniper ZTP over HTTP.  File-server via Option 66.
#  Priority: specific serials > generic profiles (sequential if/elsif).
#  MAC-matched devices use host{} declarations (highest precedence).
# =====================================================================
default-lease-time 600;
max-lease-time 7200;
option subnet-mask {{ netmask }};
option routers {{ router }};

# --- Juniper ZTP custom Option 43 suboptions ---
option space NEW_OP;
option NEW_OP.config-file-name code 1 = text;
option NEW_OP.transfer-mode    code 3 = text;
option NEW_OP-encapsulation     code 43 = encapsulate NEW_OP;

# --- Standard Option 66: file-server IP ---
option tftp-server-name "{{ vm_ip }}";

subnet {{ subnet }} netmask {{ netmask }} {
    range {{ range_low }} {{ range_high }};

    # =================================================================
    # SEQUENTIAL if/elsif (priority enforced top-down)
    #   1) specific devices matched by SERIAL  (~= "<serial>$", anchored)
    #   2) generic profiles matched by vendor-class (~= "<class>")
    # =================================================================
{% set ns = namespace(first=true) %}
{% for d in serial_devices %}
    {% if ns.first %}if{% else %}elsif{% endif %} option vendor-class-identifier ~= "{{ d.serial_number }}$" {
        option NEW_OP.transfer-mode "http";
        option NEW_OP.config-file-name "configs/{{ d.specific_config_file }}";
    }
{% set ns.first = false %}
{% endfor %}
{% for p in profiles %}
    {% if ns.first %}if{% else %}elsif{% endif %} option vendor-class-identifier ~= "{{ p.vendor_class }}" {
        option NEW_OP.transfer-mode "http";
        option NEW_OP.config-file-name "configs/{{ p.config_file }}";
    }
{% set ns.first = false %}
{% endfor %}

    # =================================================================
    # Specific devices matched by MAC (host declarations)
    # =================================================================
{% for d in mac_devices %}
    host {{ d.hostname }} {
        hardware ethernet {{ d.mac_address }};
        fixed-address {{ d.ip_address }};
        option NEW_OP.transfer-mode "http";
        option NEW_OP.config-file-name "configs/{{ d.specific_config_file }}";
    }
{% endfor %}
}
