# =====================================================================
# /etc/dhcp/dhcpd.conf — generated by ztp-app
# Mode: {{ mode }}
# =====================================================================
default-lease-time {{ lease_time }};
max-lease-time {{ max_lease_time }};
option subnet-mask {{ netmask }};
{% if router %}option routers {{ router }};{% endif %}
{% if dns_servers %}option domain-name-servers {{ dns_servers }};{% endif %}
{% if mode == "ZTP_PROVISIONING" %}
option space NEW_OP;
option NEW_OP.config-file-name code 1 = text;
option NEW_OP.transfer-mode code 3 = text;
option NEW_OP-encapsulation code 43 = encapsulate NEW_OP;
option tftp-server-name "{{ vm_ip }}";
{% elif mode == "DHCP_FILE_SERVER" and advertise_file_server %}
option tftp-server-name "{{ vm_ip }}";
{% endif %}

subnet {{ subnet }} netmask {{ netmask }} {
    range {{ range_low }} {{ range_high }};
    # Persist raw DHCP Option 60 in each lease. The application reads this
    # vendor-string as its authoritative provisioning identity source.
    set vendor-string = option vendor-class-identifier;
{% if mode == "ZTP_PROVISIONING" %}
{% set ns = namespace(first=true) %}
{% for d in serial_devices %}
    {% if ns.first %}if{% else %}elsif{% endif %} option vendor-class-identifier ~= "{{ d.serial_number }}$" {
        option NEW_OP.transfer-mode "http";
        option NEW_OP.config-file-name "ztp/config";
    }
{% set ns.first = false %}
{% endfor %}
{% for d in serial_auto_devices %}
    {% if ns.first %}if{% else %}elsif{% endif %} option vendor-class-identifier ~= "{{ d.serial_number }}$" {
        option NEW_OP.transfer-mode "http";
        option NEW_OP.config-file-name "ztp/config";
    }
{% set ns.first = false %}
{% endfor %}
{% for p in profiles %}
{% if p.assignment_type != "DHCP_ONLY" %}
    {% if ns.first %}if{% else %}elsif{% endif %} option vendor-class-identifier ~= "{{ p.match_expression }}" {
        option NEW_OP.transfer-mode "http";
        option NEW_OP.config-file-name "ztp/config";
    }
{% set ns.first = false %}
{% endif %}
{% endfor %}
{% elif mode == "DHCP_FILE_SERVER" %}
{# DHCP + File Server only provides network parameters. #}
{% for d in mac_reservations %}
    host {{ d.hostname }} {
        hardware ethernet {{ d.mac_address }};
        fixed-address {{ d.ip_address }};
    }
{% endfor %}
{% endif %}
}
